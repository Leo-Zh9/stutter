# Attempt 1: swap only the plugin's files, keep better-auth and @better-auth/core at 1.7.4.
$ npx --offline -y bun@1.4.2 run probe.ts .../@better-auth/stripe/dist/index.mjs   (1.7.25 dist, 1.7.4 peers)
SyntaxError: Export named 'HIDE_METADATA' not found in module '.../@better-auth+core@1.7.4+b3f57b135e6e65e2/node_modules/@better-auth/core/dist/api/index.mjs'.
# 1.7.25 imports HIDE_METADATA from @better-auth/core/api, which core 1.7.4 does not export.
# So the plugin cannot load without its peer. The swap was removed.

# Attempt 2: bump the plugin and its required peer better-auth, in apps/api only.
$ cd .targets/react-starter-kit-ba1725
$ sed -i '' 's|"@better-auth/stripe": "^1.7.4"|"@better-auth/stripe": "1.7.25"|; s|"better-auth": "^1.7.4"|"better-auth": "1.7.25"|' apps/api/package.json
